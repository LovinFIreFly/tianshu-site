<view class="container">
  <view class="search-bar">
    <input class="search-input" placeholder="搜剧本名 / 简介" value="{{q}}" bindinput="onInput" confirm-type="search" bindconfirm="search"/>
    <text class="search-btn" bindtap="search">搜索</text>
  </view>
  <view wx:for="{{list}}" wx:key="id" class="card script-card" bindtap="goDetail" data-sid="{{item.id}}">
    <image class="cover" src="{{item.cover || '/assets/tab/script.png'}}" mode="aspectFill"/>
    <view class="info">
      <text class="s-title">{{item.title}}</text>
      <text class="subtitle">{{item.min}}-{{item.max}}人 · {{item.duration}} · 难度{{item.diff}}</text>
      <view class="tags">
        <text class="tag" wx:for="{{item.tags || []}}" wx:key="index">{{item}}</text>
      </view>
      <text class="price">¥{{item.price}}</text>
    </view>
  </view>
  <view wx:if="{{!list.length && !loading}}" class="empty">没有找到相关剧本</view>
</view>
