# ============================================================================
# 甜薯剧本杀 · Nginx 前端样例（放在 Flask / waitress 之前）
# ----------------------------------------------------------------------------
# 作用（对应 OPTIMIZATION-REPORT 的"部署侧"那一栏）：
#   · 静态文件由 Nginx 直出，不走 Flask（Flask 只处理动态请求）
#   · Brotli 优先、gzip 兜底（比应用层的标准库 gzip 更省客户端流量）
#   · HTTP/2 多路复用
#   · /static/* 长缓存；/sw.js 不缓存（否则 Service Worker 更新会卡住）
#   · X-Forwarded-Proto 让 Flask 的 request.is_secure 成立 → 才会发 HSTS
# 安全头由应用统一发（见 tianshu/__init__.py 的 _security_headers），这里**不重复**加，
# 免得同一响应出现两组冲突值。
#
# 用法：按实际域名/路径/端口改，然后 include 进主配置。上游端口与 `python app.py --port N` 一致。
# ============================================================================

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# 若要让 includeSubDomains 的 HSTS 成立，记得先确认所有子域都支持 HTTPS。

server {
    listen 443 ssl;
    http2 on;                        # nginx ≥ 1.25.1；旧版改为 listen 443 ssl http2;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    # ---- 静态资源：Nginx 直出 + 长缓存 ----
    # <repo>/tianshu/static
    location /static/ {
        alias /srv/tianshu/tianshu/static/;
        access_log off;
        expires 180d;
        add_header Cache-Control "public, max-age=15552000, immutable";
    }

    # Service Worker 必须不缓存，否则浏览器会一直用旧版本
    location = /sw.js {
        proxy_pass http://127.0.0.1:8081;
        add_header Cache-Control "no-cache";
        add_header Service-Worker-Allowed "/";
    }

    # ---- 其它请求：反代给 waitress ----
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # ⚠️ 让 Flask 的 request.is_secure 成立（才会发 HSTS）。
        # Flask 侧需配合 werkzeug 的 ProxyFix 才认这个头：
        #   from werkzeug.middleware.proxy_fix import ProxyFix
        #   app.wsgi_app = ProxyFix(app.wsgi_app, x_for=1, x_proto=1, x_host=1)
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- 压缩：Brotli 优先，gzip 兜底（模块不可用时 brotli 行可删）----
    brotli              on;
    brotli_comp_level   5;
    brotli_min_length   1024;
    brotli_types text/plain text/css application/javascript application/json
                 image/svg+xml application/manifest+json application/xml;

    gzip                on;
    gzip_vary           on;
    gzip_comp_level     6;
    gzip_min_length     1024;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/manifest+json application/xml;
}

# HTTP → HTTPS 跳转
server {
    listen 80;
    server_name example.com;
    return 301 https://$host$request_uri;
}
